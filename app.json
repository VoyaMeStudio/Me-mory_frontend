{
  "expo": {
    "name": "Me-mory",
    "slug": "Me-mory",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memory",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
  "supportsTablet": true,
  "bundleIdentifier": "com.memory.app",
  "infoPlist": {
    "KAKAO_APP_KEY": "e6ff7fc1bce4e6ed7a1fd05d445b053e",
    "CFBundleURLTypes": [
      {
        "CFBundleTypeRole": "Editor",
        "CFBundleURLSchemes": [
          "kakaoe6ff7fc1bce4e6ed7a1fd05d445b053e"
        ]
      }
    ],
    "LSApplicationQueriesSchemes": [
      "kakaokompassauth",
      "storykompassauth",
      "kakaolink"
    ],

    "NSPhotoLibraryUsageDescription": "프로필 사진을 설정하기 위해 사진 보관함 접근이 필요합니다.",
    "NSCameraUsageDescription": "프로필 사진 촬영을 위해 카메라 접근이 필요합니다.",
    "NSPhotoLibraryAddUsageDescription": "사진을 저장할 때 사진 보관함 접근이 필요합니다."
  }
},
    "android": {
      "package": "com.memory.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "kakaoe6ff7fc1bce4e6ed7a1fd05d445b053e"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 업로드하기 위해 사진 접근 권한이 필요합니다.",
          "cameraPermission": "프로필 사진 촬영을 위해 카메라 권한이 필요합니다."
        }
      ],
      "expo-secure-store",
      "expo-asset"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}